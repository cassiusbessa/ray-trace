# Teste consolidado de validações
# Este arquivo contém uma linha válida e várias inválidas para demonstrar as validações

# Válido
A 0.3 200,200,200

# Inválidos para demonstrar cada tipo de erro:
# 1. Parâmetros faltantes
A 0.2

# 2. Parâmetros excedentes  
C 0,0,-3 0,0,1 70 extra_param

# 3. Cores fora do range
L -10,10,-10 0.7 300,-50,255

# 4. Valores fora do range
sp 0,0,5 -3 255,0,0

# 5. FOV inválido
C 0,0,-5 0,0,1 200

# 6. Intensidade de luz inválida
L 0,5,0 1.5 255,255,255

# 7. Vetor orientação zero
cy 0,0,10 0,0,0 2.0 4.0 255,0,0 1

# 8. Formato RGB inválido
sp 0,0,15 2 255255,100

# Uma linha válida no final
sp 0,0,20 2 100,150,200
